# Copy this file to ".env" in the same folder and fill in real values.
# Never commit the real ".env" file — it is already in .gitignore.

# ---- Server ----
PORT=4000
NODE_ENV=development
# Comma-separate multiple origins if needed, e.g. for a deployed frontend + local dev
FRONTEND_URL=http://localhost:5173

# ---- Database ----
# Path to the SQLite database file. For cloud deployment, point this at a
# persistent disk/volume path (see README "Cloud Deployment").
DB_PATH=./data/idcp.sqlite3

# ---- Auth ----
# Required. Generate a long random value, e.g.: openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRES_IN=8h

# ---- Payment gateway (Razorpay TEST/SANDBOX mode) ----
# Get free test keys at https://dashboard.razorpay.com/app/keys (Test Mode).
# Test key ids start with "rzp_test_...". If left blank, the backend
# automatically falls back to a built-in offline mock gateway so payments
# can still be demoed end-to-end without signing up for anything.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Used only by the mock gateway fallback above when Razorpay keys are blank.
MOCK_GATEWAY_SECRET=change-me-too

# ---- Seed data / test accounts ----
# Passwords for the four demo accounts created by `npm run seed`.
# If left blank, seed.js generates a random password and prints it once —
# but for repeatable local logins, set these explicitly.
SEED_ADMIN_EMAIL=admin@idcp.com
SEED_ADMIN_PASSWORD=
SEED_DESIGNER_EMAIL=designer@idcp.com
SEED_DESIGNER_PASSWORD=
SEED_CUSTOMER_EMAIL=customer@idcp.com
SEED_CUSTOMER_PASSWORD=
SEED_CONTRACTOR_EMAIL=contractor@idcp.com
SEED_CONTRACTOR_PASSWORD=
